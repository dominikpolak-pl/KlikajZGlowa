@page "/profile-details"
@attribute [Authorize]

@using KlikajZGlowa.Service.DTO.ApplicationUser

@inject HttpClient Http
@inject IAuthorClientService AuthorService
@inject IAuthorApplicationClientService ApplicationService
@inject IAuthService AuthService

<PageTitle>Profil użytkownika - Klikaj z Głową</PageTitle>

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4 text-primary">
                    Edycja profilu
                </h3>

				@if(isLoading)
				{
					<div class="text-center my-4">
						<div class="spinner-border text-primary"></div>
					</div>
				}
				else if (!string.IsNullOrWhiteSpace(errorMessage))
				{
					<div class="alert alert-danger">
						@errorMessage
					</div>
				}
				else
				{
					<EditForm Model="@model" OnValidSubmit="SaveProfile">
						<DataAnnotationsValidator />
						<ValidationSummary class="text-danger" />
							@if(!string.IsNullOrWhiteSpace(successMessage))
							{
								<div class="alert alert-success">
									@successMessage
								</div>
							}

							<div class="row">
								<div class="col-md-6 mb-3">
									<label class="form-label">Imię</label>

									<InputText class="form-control"
											   @bind-Value="model.FirstName"
											   placeholder="Jan" />

									<ValidationMessage For="@(() => model.FirstName)"
													   class="text-danger small" />
								</div>

								<div class="col-md-6 mb-3">
									<label class="form-label">Nazwisko</label>

									<InputText class="form-control"
											   @bind-Value="model.LastName"
											   placeholder="Kowalski" />

									<ValidationMessage For="@(() => model.LastName)"
													   class="text-danger small" />
								</div>
							</div>

							<div class="mb-3">
								<label class="form-label">Adres e-mail</label>

								<input class="form-control"
									   value="@email"
									   disabled />

								<div class="form-text">
									Adresu e-mail nie można zmienić w tym formularzu.
								</div>
							</div>

							<div class="mb-4">
								<label class="form-label">Numer telefonu</label>

								<InputText class="form-control"
										   @bind-Value="model.PhoneNumber"
										   placeholder="+48 123 456 789" />
							</div>

							<button type="submit"
									class="btn btn-primary w-100"
									disabled="@isSaving">
								@if (isSaving)
								{
									<span class="spinner-border spinner-border-sm me-2"></span>
									<span>Zapisywanie...</span>
								}
								else
								{
									<span>Zapisz zmiany</span>
								}
							</button>
					</EditForm>
				}


			</div>
			@if (!isLoading)
			{
				<div class="card-footer bg-light p-4 border-top">
					@if (isAuthor)
					{
						<div class="alert alert-success mb-0 d-flex align-items-center justify-content-between">
							<span>Jesteś zarejestrowany jako <strong>Autor</strong>.</span>
							<a href="/courses/create" class="btn btn-sm btn-outline-success">Twórz kursy</a>
						</div>
					}
					else if (hasPendingApplication)
					{
						<div class="alert alert-warning mb-0">
							<strong>Twoje zgłoszenie jest weryfikowane.</strong><br />
							<small class="text-muted">Administrator analizuje Twoją prośbę o nadanie uprawnień twórcy kursów.</small>
						</div>
					}
					else
					{
						<h6 class="fw-bold mb-2">Chcesz publikować własne kursy?</h6>
						<p class="text-muted small mb-3">
							Złóż wniosek o nadanie uprawnień Autora. Po akceptacji przez administratora otrzymasz dostęp do modułu tworzenia materiałów szkoleniowych.
						</p>

						<div class="mb-3">
							<label class="form-label small text-muted">Dlaczego chcesz zostać autorem? (opcjonalnie)</label>
							<textarea class="form-control"
									  rows="3"
									  placeholder="Opisz krótko swoje doświadczenie lub tematykę planowanych kursów..."
									  @bind="motivationText"
									  disabled="@isSubmittingApplication"></textarea>
						</div>

						<button type="button"
								class="btn btn-outline-primary w-100"
								@onclick="SubmitAuthorApplication"
								disabled="@isSubmittingApplication">
							@if (isSubmittingApplication)
							{
								<span class="spinner-border spinner-border-sm me-2"></span>
								<span>Wysyłanie wniosku...</span>
							}
							else
							{
								<span>Wyślij prośbę o konto Autora</span>
							}
						</button>
					}
				</div>
			}
		</div>
	</div>
</div>

@code {
	private UpdateApplicationUserDto model = new();

	private string? userId;
	private string email = string.Empty;
	private string? errorMessage;
	private string? successMessage;
	private bool isAuthor;
	private bool hasPendingApplication;
	private string motivationText = string.Empty;

	private bool isLoading = true;
	private bool isSaving;
	private bool isSubmittingApplication;


	protected override async Task OnInitializedAsync()
	{
		try
		{
			var currentUser = await AuthService.GetAsync();

			if (currentUser is null)
			{
				errorMessage = "Nie udało się pobrać danych profilu";
				return;
			}

			userId = currentUser.Id;
			email = currentUser.Email;
			isAuthor = currentUser.AuthorId.HasValue;

			if (!isAuthor)
			{
				hasPendingApplication = await ApplicationService.HasPendingApplicationAsync();
			}

			model.FirstName = currentUser.FirstName;
			model.LastName = currentUser.LastName;
			model.PhoneNumber = currentUser.PhoneNumber;
		}
		catch (HttpRequestException)
		{
			errorMessage = "Nie udało się połączyć z serwerem.";
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task SaveProfile()
	{
		if (string.IsNullOrWhiteSpace(userId))
		{
			errorMessage = "Nie znaleziono użytkownika.";
			return;
		}

		isSaving = true;
		errorMessage = null;
		successMessage = null;

		try
		{
			var response = await AuthService.UpdateAsync(userId, model);

			if(response)
			{
				successMessage = "Dane profilu zostały zapisane.";
			}
			else
			{
				errorMessage = "Nie udało się zapisać danych profilu.";
			}
		}
		catch (HttpRequestException)
		{
			errorMessage = "Nie udało się połączyć z serwerem.";
		}
		finally
		{
			isSaving = false;
		}

	}

	private async Task SubmitAuthorApplication()
	{
		isSubmittingApplication = true;
		errorMessage = null;
		successMessage = null;

		try
		{
			var success = await ApplicationService.SubmitAsync(motivationText);
			if(success)
			{
				hasPendingApplication = true;
				successMessage = "Twój wniosek o profil Autora został przesłany do administratora.";
			}
			else
			{
				errorMessage = "Nie udało się przesłać zgłoszenia (być może masz już oczekujący wniosek).";
			}
		}
		catch (HttpRequestException)
		{
			errorMessage = "Błąd połączenia z serwerem podczas wysyłania wniosku.";
		}
		finally
		{
			isSubmittingApplication = false;
		}
	}
}

