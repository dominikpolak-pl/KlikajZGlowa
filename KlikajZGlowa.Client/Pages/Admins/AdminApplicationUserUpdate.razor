@page "/admin/details/{Id}"
@attribute [Authorize(Roles = "Admin")]

@using KlikajZGlowa.Model
@using KlikajZGlowa.Service.DTO.ApplicationUser

@inject IAuthorApplicationClientService ApplicationService
@inject NavigationManager Navigation
@inject IAuthService AuthService

<PageTitle>Profil użytkownika - Klikaj z Głową</PageTitle>

<div class="row justify-content-center mt-4 mb-5">
	<div class="col-md-7 col-lg-6">
		<div class="d-flex justify-content-between align-items-center mb-3">
			<a href="/admin/applicationuser" class="btn btn-outline-secondary btn-sm">
				&larr; Powrót do listy użytkowników
			</a>
			<span class="badge bg-light text-secondary border">GUID: @Id</span>
		</div>

		<!-- Główna karta: Edycja profilu -->
		<div class="card shadow-sm border-0 mb-4">
			<div class="card-body p-4">
				<h3 class="card-title text-center mb-4 text-primary">
					Edycja profilu użytkownika
				</h3>

				@if (isLoading)
				{
					<div class="text-center my-4">
						<div class="spinner-border text-primary" role="status"></div>
					</div>
				}
				else if (!string.IsNullOrWhiteSpace(errorMessage))
				{
					<div class="alert alert-danger" role="alert">
						@errorMessage
					</div>
				}
				else
				{
					<EditForm Model="@model" OnValidSubmit="SaveProfile">
						<DataAnnotationsValidator />
						<ValidationSummary class="text-danger mb-3" />

						@if (!string.IsNullOrWhiteSpace(profileSuccessMessage))
						{
							<div class="alert alert-success alert-dismissible fade show" role="alert">
								@profileSuccessMessage
								<button type="button" class="btn-close" @onclick="() => profileSuccessMessage = null"></button>
							</div>
						}

						<div class="row">
							<div class="col-md-6 mb-3">
								<label class="form-label">Imię</label>
								<InputText class="form-control"
										   @bind-Value="model.FirstName"
										   placeholder="Jan" />
								<ValidationMessage For="@(() => model.FirstName)"
												   class="text-danger small" />
							</div>

							<div class="col-md-6 mb-3">
								<label class="form-label">Nazwisko</label>
								<InputText class="form-control"
										   @bind-Value="model.LastName"
										   placeholder="Kowalski" />
								<ValidationMessage For="@(() => model.LastName)"
												   class="text-danger small" />
							</div>
						</div>

						<div class="mb-3">
							<label class="form-label">Adres e-mail</label>
							<input class="form-control bg-light"
								   value="@email"
								   disabled />
							<div class="form-text">
								Adresu e-mail nie można zmienić w tym formularzu.
							</div>
						</div>

						<div class="mb-4">
							<label class="form-label">Numer telefonu</label>
							<InputText class="form-control"
									   @bind-Value="model.PhoneNumber"
									   placeholder="+48 123 456 789" />
						</div>

						<button type="submit"
								class="btn btn-primary w-100"
								disabled="@isSaving">
							@if (isSaving)
							{
								<span class="spinner-border spinner-border-sm me-2"></span>
								<span>Zapisywanie profilu...</span>
							}
							else
							{
								<span>Zapisz dane profilu</span>
							}
						</button>
					</EditForm>
				}
			</div>

			@if (!isLoading && string.IsNullOrWhiteSpace(errorMessage))
			{
				<div class="card-footer bg-light p-3 border-top">
					@if (isAuthor)
					{
						<div class="alert alert-success mb-0 d-flex align-items-center justify-content-between py-2">
							<span>Użytkownik posiada aktywne konto <strong>Autora</strong>.</span>
						</div>
					}
					else if (hasPendingApplication)
					{
						<div class="alert alert-warning mb-0 d-flex align-items-center justify-content-between py-2">
							<div>
								<strong>Wniosek o profil Autora oczekuje na decyzję.</strong>
							</div>
							<a href="/admin/applications" class="btn btn-sm btn-outline-warning">
								Rozpatrz wniosek
							</a>
						</div>
					}
					else
					{
						<div class="text-muted small">
							Status wniosków: brak oczekującego wniosku o rolę twórcy.
						</div>
					}
				</div>
			}
		</div>

		@if (!isLoading && string.IsNullOrWhiteSpace(errorMessage))
		{
			<!-- Karta 2: Zarządzanie rolami -->
			<div class="card shadow-sm border-0 mb-4">
				<div class="card-body p-4">
					<h5 class="card-title fw-bold text-dark mb-2">Zarządzanie rolami</h5>
					<p class="text-muted small mb-3">Zaznacz role, które ma posiadać użytkownik w systemie:</p>

					@if (!string.IsNullOrWhiteSpace(rolesSuccessMessage))
					{
						<div class="alert alert-success alert-dismissible fade show" role="alert">
							@rolesSuccessMessage
							<button type="button" class="btn-close" @onclick="() => rolesSuccessMessage = null"></button>
						</div>
					}
					@if (!string.IsNullOrWhiteSpace(rolesErrorMessage))
					{
						<div class="alert alert-danger alert-dismissible fade show" role="alert">
							@rolesErrorMessage
							<button type="button" class="btn-close" @onclick="() => rolesErrorMessage = null"></button>
						</div>
					}

					<div class="list-group mb-3">
						<label class="list-group-item d-flex gap-3 align-items-center">
							<input class="form-check-input flex-shrink-0" type="checkbox"
								   checked="@selectedRoles.Contains(AppRoles.EnrolledUser)"
								   @onchange='(e) => ToggleRole(AppRoles.EnrolledUser, e.Value)' />
							<div>
								<strong class="d-block">@AppRoles.EnrolledUser (Kursant)</strong>
								<small class="text-muted">Podstawowy dostęp do platformy i możliwość zapisu na kursy.</small>
							</div>
						</label>

						<label class="list-group-item d-flex gap-3 align-items-center">
							<input class="form-check-input flex-shrink-0" type="checkbox"
								   checked="@selectedRoles.Contains(AppRoles.Author)"
								   @onchange='(e) => ToggleRole(AppRoles.Author, e.Value)' />
							<div>
								<strong class="d-block">@AppRoles.Author (Twórca kursów)</strong>
								<small class="text-muted">Tworzenie kursów, lekcji i publikowanie materiałów dydaktycznych.</small>
							</div>
						</label>

						<label class="list-group-item d-flex gap-3 align-items-center">
							<input class="form-check-input flex-shrink-0" type="checkbox"
								   checked="@selectedRoles.Contains(AppRoles.Admin)"
								   @onchange='(e) => ToggleRole(AppRoles.Admin, e.Value)' />
							<div>
								<strong class="d-block text-danger">@AppRoles.Admin (Administrator)</strong>
								<small class="text-muted">Pełne uprawnienia zarządzania serwisem i użytkownikami.</small>
							</div>
						</label>
					</div>

					<button class="btn btn-outline-primary w-100" @onclick="SaveRoles" disabled="@isSavingRoles">
						@if (isSavingRoles)
						{
							<span class="spinner-border spinner-border-sm me-2"></span>
							<span>Aktualizowanie ról...</span>
						}
						else
						{
							<span>Zapisz uprawnienia ról</span>
						}
					</button>
				</div>
			</div>

			<!-- Karta 3: Usunięcie użytkownika -->
			<div class="card shadow-sm border-danger">
				<div class="card-body p-4">
					<h5 class="card-title text-danger fw-bold mb-2">Strefa niebezpieczna</h5>
					<p class="text-muted small mb-3">
						Usunięcie użytkownika jest operacją trwałą. Spowoduje to wyczyszczenie powiązanych profili oraz wniosków.
					</p>

					@if (!string.IsNullOrWhiteSpace(deleteErrorMessage))
					{
						<div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
							@deleteErrorMessage
							<button type="button" class="btn-close" @onclick="() => deleteErrorMessage = null"></button>
						</div>
					}

					@if (!showDeleteConfirm)
					{
						<button class="btn btn-outline-danger" @onclick="() => showDeleteConfirm = true">
							Usuń to konto
						</button>
					}
					else
					{
						<div class="alert alert-danger p-3 mb-0">
							<p class="mb-2 fw-bold">Czy na pewno chcesz bezpowrotnie usunąć konto @email?</p>
							<div class="d-flex gap-2">
								<button class="btn btn-danger btn-sm" @onclick="DeleteUser" disabled="@isDeleting">
									@if (isDeleting)
									{
										<span class="spinner-border spinner-border-sm me-1"></span>
										<span>Usuwanie...</span>
									}
									else
									{
										<span>Tak, potwierdzam usunięcie</span>
									}
								</button>
								<button class="btn btn-secondary btn-sm" @onclick="() => showDeleteConfirm = false" disabled="@isDeleting">
									Anuluj
								</button>
							</div>
						</div>
					}
				</div>
			</div>
		}
	</div>
</div>

@code {
	[Parameter]
	public string Id { get; set; } = string.Empty;

	private UpdateApplicationUserDto model = new();
	private List<string> selectedRoles = new();

	private string email = string.Empty;
	private string? errorMessage;
	private string? profileSuccessMessage;
	private string? rolesSuccessMessage;
	private string? rolesErrorMessage;
	private string? deleteErrorMessage;

	private bool isAuthor;
	private bool hasPendingApplication;

	private bool isLoading = true;
	private bool isSaving;
	private bool isSavingRoles;
	private bool isDeleting;
	private bool showDeleteConfirm;

	protected override async Task OnInitializedAsync()
	{
		await LoadUser();
	}

	private async Task LoadUser()
	{
		isLoading = true;
		errorMessage = null;

		try
		{
			var updatedUser = await AuthService.GetByIdAsync(Id);

			if (updatedUser is null)
			{
				errorMessage = "Nie udało się pobrać danych profilu użytkownika.";
				return;
			}

			email = updatedUser.Email;
			model.FirstName = updatedUser.FirstName;
			model.LastName = updatedUser.LastName;
			model.PhoneNumber = updatedUser.PhoneNumber;

			selectedRoles = await AuthService.GetRolesAsync(Id);
			isAuthor = selectedRoles.Contains(AppRoles.Author) || updatedUser.AuthorId.HasValue;

			if (!isAuthor)
			{
				hasPendingApplication = await ApplicationService.HasPendingApplicationByIdAsync(Id);
			}
		}
		catch (HttpRequestException)
		{
			errorMessage = "Nie udało się połączyć z serwerem.";
		}
		finally
		{
			isLoading = false;
		}
	}

	private void ToggleRole(string role, object? isChecked)
	{
		var checkedValue = isChecked is bool b && b;
		if (checkedValue && !selectedRoles.Contains(role))
		{
			selectedRoles.Add(role);
		}
		else if (!checkedValue && selectedRoles.Contains(role))
		{
			selectedRoles.Remove(role);
		}
	}

	private async Task SaveProfile()
	{
		if (string.IsNullOrWhiteSpace(Id)) return;

		isSaving = true;
		profileSuccessMessage = null;

		try
		{
			var response = await AuthService.UpdateAsync(Id, model);

			if (response)
			{
				profileSuccessMessage = "Dane profilu zostały pomyślnie zaktualizowane.";
			}
			else
			{
				errorMessage = "Nie udało się zapisać danych profilu.";
			}
		}
		catch (HttpRequestException)
		{
			errorMessage = "Nie udało się połączyć z serwerem.";
		}
		finally
		{
			isSaving = false;
		}
	}

	private async Task SaveRoles()
	{
		if (string.IsNullOrWhiteSpace(Id)) return;

		isSavingRoles = true;
		rolesSuccessMessage = null;
		rolesErrorMessage = null;

		var result = await AuthService.UpdateRolesAsync(Id, selectedRoles);

		if (result.Success)
		{
			rolesSuccessMessage = "Role użytkownika zostały zaktualizowane.";
			isAuthor = selectedRoles.Contains(AppRoles.Author);

			if (!isAuthor)
			{
				hasPendingApplication = await ApplicationService.HasPendingApplicationByIdAsync(Id);
			}
			else
			{
				hasPendingApplication = false;
			}
		}
		else
		{
			rolesErrorMessage = result.ErrorMessage ?? "Nie udało się zaktualizować ról.";
		}

		isSavingRoles = false;
	}

	private async Task DeleteUser()
	{
		if (string.IsNullOrWhiteSpace(Id)) return;

		isDeleting = true;
		deleteErrorMessage = null;

		var result = await AuthService.DeleteUserAsync(Id);

		if (result.Success)
		{
			Navigation.NavigateTo("/admin/applicationuser");
		}
		else
		{
			deleteErrorMessage = result.ErrorMessage ?? "Wystąpił błąd podczas usuwania konta.";
			showDeleteConfirm = false;
		}

		isDeleting = false;
	}
}