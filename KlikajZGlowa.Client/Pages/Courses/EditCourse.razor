@page "/courses/{Id:int}/edit"
@attribute [Authorize(Roles = "Admin, Author")]

@using KlikajZGlowa.Service.DTO.Course
@inject ICourseClientService CourseService
@inject NavigationManager Navigation

<PageTitle>Edycja Kursu - Klikaj z Głową</PageTitle>

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="card-title text-primary mb-0">Edycja Kursu</h3>
                    <a href="@($"/courses/{Id}")" class="btn btn-outline-secondary btn-sm">Anuluj</a>
                </div>

                @if (isLoading)
                {
                    <div class="text-center my-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">Pobieranie danych kursu...</p>
                    </div>
                }
                else if (notFound)
                {
                    <div class="alert alert-danger">
                        Kurs o podanym identyfikatorze nie został odnaleziony.
                    </div>
                    <a href="/courses" class="btn btn-secondary">Wróć do listy kursów</a>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }

                    <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger small mb-3" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tytuł kursu</label>
                            <InputText class="form-control" @bind-Value="model.Title" placeholder="Wprowadź tytuł..." />
                            <ValidationMessage For="@(() => model.Title)" class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Opis kursu</label>
                            <InputTextArea class="form-control" rows="5" @bind-Value="model.Description" placeholder="Wprowadź opis kursu..." />
                            <ValidationMessage For="@(() => model.Description)" class="text-danger small" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Zapisywanie...</span>
                                }
                                else
                                {
                                    <span>Zapisz zmiany</span>
                                }
                            </button>
                            <a href="@($"/courses/{Id}")" class="btn btn-outline-secondary">Wróć do kursu</a>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateCourseDto model = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool notFound = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCourseData();
    }

    private async Task LoadCourseData()
    {
        isLoading = true;
        errorMessage = null;

        var existingCourse = await CourseService.GetByIdAsync(Id);

        if (existingCourse is null)
        {
            notFound = true;
        }
        else
        {
            model = new UpdateCourseDto
            {
                CourseId = existingCourse.CourseId,
                Title = existingCourse.Title,
                Description = existingCourse.Description
            };
        }

        isLoading = false;
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        var success = await CourseService.UpdateAsync(Id, model);

        if (success)
        {
            // Po udanej edycji wracamy do widoku szczegółów kursu
            Navigation.NavigateTo($"/courses/{Id}");
        }
        else
        {
            errorMessage = "Nie udało się zaktualizować kursu. Upewnij się, że jesteś autorem tego materiału.";
        }

        isSubmitting = false;
    }
}