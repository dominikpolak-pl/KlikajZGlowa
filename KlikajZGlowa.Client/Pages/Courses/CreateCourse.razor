@page "/courses/create"
@attribute [Authorize(Roles = "Admin, Author")]

@using KlikajZGlowa.Service.DTO.Course
@inject ICourseClientService CourseService
@inject NavigationManager Navigation

<PageTitle>Stwórz Nowy Kurs</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h3 class="card-title mb-4">Nowy Kurs</h3>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Tytuł kursu:</label>
                        <InputText class="form-control" @bind-Value="model.Title" />
                        <ValidationMessage For="@(() => model.Title)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Opis kursu:</label>
                        <InputTextArea class="form-control" rows="4" @bind-Value="model.Description" />
                        <ValidationMessage For="@(() => model.Description)" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Zapisz i Opublikuj
                        </button>
                        <a href="/courses" class="btn btn-outline-secondary">Anuluj</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateCourseDto model = new();
    private bool isSubmitting = false;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        var created = await CourseService.CreateAsync(model);
        if (created != null)
        {
            Navigation.NavigateTo($"/courses/{created.CourseId}");
        }
        else
        {
            errorMessage = "Wystąpił błąd podczas tworzenia kursu. Upewnij się, że masz uprawnienia autora.";
        }

        isSubmitting = false;
    }
}